# Copy to .env (never commit .env)

# Required unless CHATBOT_OFFLINE=1. Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Demo/test mode without any API key: scripted answers + hash embeddings (see offline.py)
# CHATBOT_OFFLINE=1

# Optional (defaults shown)
# GEMINI_MODEL=gemini-2.5-flash
# EMBEDDING_MODEL=models/embedding-001
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# TRANSCRIPT_FILE=transcript.txt
# BOOK_FILE=kitap.txt
# VECTOR_DB_PATH=./chroma_db        # Render: /var/data/chroma_db
# PORT=8000                         # Render sets this itself
